# Defaults: local SQLite + strictly test-only payments.
# Node.js >=24 required for built-in SQLite. Do not use on an ephemeral production disk.
DATA_PATH=.data/sabai.sqlite
# Optional hosted Postgres (Supabase pooler recommended). Apply migrations first.
DATABASE_URL=
# Supabase Auth production admin access. Anon key is not a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# LOCAL DEVELOPMENT ONLY. Set a strong unique password; never commit its value.
ADMIN_PASSWORD=
# At least 32 random bytes for stable local sessions. No fixed default is shipped.
SESSION_SECRET=
# Local development shows labeled internal references automatically.
# Keep false on any publicly accessible server unless consent has been granted.
INTERNAL_PREVIEW=false
MEDIA_APPROVED=false
# No payment credentials are required or accepted by the current test adapter.
# Real payments remain hard-disabled until a verified provider adapter is implemented.

# Public HTTPS origin behind a reverse proxy (optional stricter CSRF check).
APP_ORIGIN=
